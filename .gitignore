# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies and package-manager caches
/node_modules/
/.pnpm-store/
/.npm/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and local tooling
/coverage/
.eslintcache

# Next.js generated files
/.next/
/out/
next-env.d.ts

# production output
/build/

# operating-system and local editor files
.DS_Store
Thumbs.db
.idea/

# local credentials and certificates
.env*
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel local project metadata
/.vercel/

# typescript
*.tsbuildinfo
